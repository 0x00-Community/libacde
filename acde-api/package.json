{
  "name": "@acde/api",
  "version": "1.0.0",
  "private": true,
  "description": "acde SDK: type declarations only (no JavaScript). Types of acde.config.jsonc, the package manifest, the services, the capabilities and the acde:* modules the runtime injects into a page.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "http://gitea.dopamine/AC/libacde",
    "directory": "acde-api"
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts"
    },
    "./app": {
      "types": "./src/app.d.ts"
    },
    "./shell": {
      "types": "./src/shell.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "vendor",
    "api-level",
    "min-api-level",
    "legacy-icons.json"
  ]
}
