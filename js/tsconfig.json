{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "customConditions": ["source"],
    "paths": {
      "@acde/dom": ["./dom/src/index.ts"],
      "@acde/dom/core": ["./dom/src/core/index.ts"],
      "@acde/dom/worker": ["./dom/src/worker/index.ts"],
      "@acde/api": ["../acde-api/src/index.d.ts"],
      "@acde/api/manifest": ["../manifest/index.ts"]
    }
  },
  "include": ["dom/src", "dom/test", "page/src", "page/test", "launcher/src", "launcher/test"]
}
